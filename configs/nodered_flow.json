[
  {
    "id": "tab_main",
    "type": "tab",
    "label": "Projet 11 - Maintenance prédictive",
    "disabled": false,
    "info": "MQTT (Mosquitto) -> sous-flux Prétraitement_Machine (x3) -> InfluxDB + ThingsBoard"
  },
  {
    "id": "sf_pretraitement",
    "type": "subflow",
    "name": "Prétraitement_Machine",
    "info": "Sous-flux réutilisable, paramétré par machine_id :\n1. ne garde que les messages de SA machine\n2. normalise / valide les champs capteurs\n3. appelle le modèle ML (POST /predict)\n4. renvoie la mesure enrichie de panne_probable",
    "category": "",
    "in": [{ "x": 60, "y": 80, "wires": [{ "id": "sf_switch" }] }],
    "out": [{ "x": 980, "y": 80, "wires": [{ "id": "sf_fusion", "port": 0 }] }],
    "env": [{ "name": "machine_id", "type": "str", "value": "M1" }],
    "meta": {},
    "color": "#3FADB5",
    "icon": "font-awesome/fa-cogs"
  },
  {
    "id": "sf_switch",
    "type": "switch",
    "z": "sf_pretraitement",
    "name": "Ma machine ?",
    "property": "payload.machine_id",
    "propertyType": "msg",
    "rules": [{ "t": "eq", "v": "machine_id", "vt": "env" }],
    "checkall": "true",
    "repair": false,
    "outputs": 1,
    "x": 180,
    "y": 80,
    "wires": [["sf_normaliser"]]
  },
  {
    "id": "sf_normaliser",
    "type": "function",
    "z": "sf_pretraitement",
    "name": "Normaliser / valider",
    "func": "// Prétraitement : types numériques, valeurs manquantes, type produit par défaut\nconst p = msg.payload || {};\nconst champs = [\"air_temp_k\", \"process_temp_k\", \"rpm\", \"torque_nm\", \"tool_wear_min\"];\nconst m = {\n    machine_id: env.get(\"machine_id\"),\n    type: [\"L\", \"M\", \"H\"].includes(p.type) ? p.type : \"M\",\n    ts: Number(p.ts) || Date.now()\n};\nfor (const c of champs) {\n    const v = Number(p[c]);\n    if (!Number.isFinite(v)) {\n        node.warn(`Champ invalide '${c}' pour ${m.machine_id} : message ignoré`);\n        return null;\n    }\n    m[c] = v;\n}\nif (p.panne_reelle !== undefined) m.panne_reelle = Number(p.panne_reelle);\nmsg.mesure = m;      // copie conservée pour après l'appel HTTP\nmsg.payload = m;     // corps JSON envoyé à /predict\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 370,
    "y": 80,
    "wires": [["sf_predict"]]
  },
  {
    "id": "sf_predict",
    "type": "http request",
    "z": "sf_pretraitement",
    "name": "POST /predict (modèle ML)",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://host.docker.internal:8000/predict",
    "tls": "",
    "persist": true,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 600,
    "y": 80,
    "wires": [["sf_fusion"]]
  },
  {
    "id": "sf_fusion",
    "type": "function",
    "z": "sf_pretraitement",
    "name": "Ajouter panne_probable",
    "func": "if (msg.statusCode !== 200 || typeof msg.payload !== \"object\") {\n    node.error(`API ML indisponible (HTTP ${msg.statusCode})`, msg);\n    return null;\n}\nconst p = msg.payload.panne_probable;\nmsg.payload = Object.assign({}, msg.mesure, { panne_probable: p });\nnode.status({ fill: p > 0.7 ? \"red\" : \"green\", shape: \"dot\", text: `${msg.payload.machine_id} : ${p}` });\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 830,
    "y": 80,
    "wires": [[]]
  },
  {
    "id": "broker_mosquitto",
    "type": "mqtt-broker",
    "name": "Mosquitto",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "nodered-p11",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "broker_tb",
    "type": "mqtt-broker",
    "name": "ThingsBoard (passerelle)",
    "broker": "thingsboard",
    "port": "1883",
    "clientid": "nodered-gateway",
    "autoConnect": true,
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoUnsubscribe": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": "",
    "credentials": { "user": "NODERED_GATEWAY_TOKEN", "password": "" }
  },
  {
    "id": "note_main",
    "type": "comment",
    "z": "tab_main",
    "name": "Flux : MQTT -> 3 instances du sous-flux (M1, M2, M3) -> InfluxDB + ThingsBoard",
    "info": "Pour ajouter une machine : copier une instance du sous-flux et changer machine_id.",
    "x": 330,
    "y": 40,
    "wires": []
  },
  {
    "id": "mqtt_in",
    "type": "mqtt in",
    "z": "tab_main",
    "name": "usine/+/telemetry (QoS 1)",
    "topic": "usine/+/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "broker_mosquitto",
    "nl": false,
    "rap": true,
    "rh": 0,
    "inputs": 0,
    "x": 150,
    "y": 180,
    "wires": [["sf_M1", "sf_M2", "sf_M3"]]
  },
  {
    "id": "sf_M1",
    "type": "subflow:sf_pretraitement",
    "z": "tab_main",
    "name": "Prétraitement M1",
    "env": [{ "name": "machine_id", "value": "M1", "type": "str" }],
    "x": 410,
    "y": 120,
    "wires": [["fn_influx", "fn_tb", "debug_pred"]]
  },
  {
    "id": "sf_M2",
    "type": "subflow:sf_pretraitement",
    "z": "tab_main",
    "name": "Prétraitement M2",
    "env": [{ "name": "machine_id", "value": "M2", "type": "str" }],
    "x": 410,
    "y": 180,
    "wires": [["fn_influx", "fn_tb", "debug_pred"]]
  },
  {
    "id": "sf_M3",
    "type": "subflow:sf_pretraitement",
    "z": "tab_main",
    "name": "Prétraitement M3",
    "env": [{ "name": "machine_id", "value": "M3", "type": "str" }],
    "x": 410,
    "y": 240,
    "wires": [["fn_influx", "fn_tb", "debug_pred"]]
  },
  {
    "id": "fn_influx",
    "type": "function",
    "z": "tab_main",
    "name": "Line protocol InfluxDB",
    "func": "// Format : measurement,tags champs timestamp\nconst p = msg.payload;\nconst champs = [\"air_temp_k\", \"process_temp_k\", \"rpm\", \"torque_nm\", \"tool_wear_min\", \"panne_probable\"];\nconst fields = champs.map(c => `${c}=${p[c]}`);\nfields.push(`type=\"${p.type}\"`);\nif (p.panne_reelle !== undefined) fields.push(`panne_reelle=${p.panne_reelle}i`);\nmsg.payload = `machine,machine_id=${p.machine_id} ${fields.join(\",\")} ${p.ts}`;\nmsg.headers = {\n    \"Authorization\": \"Token \" + env.get(\"INFLUX_TOKEN\"),\n    \"Content-Type\": \"text/plain; charset=utf-8\"\n};\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 680,
    "y": 120,
    "wires": [["http_influx"]]
  },
  {
    "id": "http_influx",
    "type": "http request",
    "z": "tab_main",
    "name": "InfluxDB /api/v2/write",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "http://influxdb:8086/api/v2/write?org=usine&bucket=maintenance&precision=ms",
    "tls": "",
    "persist": true,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [],
    "x": 920,
    "y": 120,
    "wires": [["fn_check_influx"]]
  },
  {
    "id": "fn_check_influx",
    "type": "function",
    "z": "tab_main",
    "name": "Écriture OK ? (204)",
    "func": "if (msg.statusCode !== 204) {\n    node.status({ fill: \"red\", shape: \"ring\", text: `HTTP ${msg.statusCode}` });\n    node.warn(`InfluxDB : ${msg.statusCode} ${msg.payload}`);\n} else {\n    node.status({ fill: \"green\", shape: \"dot\", text: \"écrit\" });\n}\nreturn null;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 1140,
    "y": 120,
    "wires": [[]]
  },
  {
    "id": "fn_tb",
    "type": "function",
    "z": "tab_main",
    "name": "Format passerelle ThingsBoard",
    "func": "// API Gateway ThingsBoard : une seule connexion MQTT pour toutes les machines\n// { \"M1\": [ { \"ts\": ..., \"values\": { ... } } ] }\nconst { machine_id, ts, ...valeurs } = msg.payload;\nmsg.topic = \"v1/gateway/telemetry\";\nmsg.payload = { [machine_id]: [{ ts: ts, values: valeurs }] };\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 700,
    "y": 200,
    "wires": [["mqtt_out_tb"]]
  },
  {
    "id": "mqtt_out_tb",
    "type": "mqtt out",
    "z": "tab_main",
    "name": "ThingsBoard v1/gateway/telemetry",
    "topic": "",
    "qos": "1",
    "retain": "false",
    "respTopic": "",
    "contentType": "",
    "userProps": "",
    "correl": "",
    "expiry": "",
    "broker": "broker_tb",
    "x": 980,
    "y": 200,
    "wires": []
  },
  {
    "id": "debug_pred",
    "type": "debug",
    "z": "tab_main",
    "name": "Prédictions",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 670,
    "y": 280,
    "wires": []
  },
  {
    "id": "catch_err",
    "type": "catch",
    "z": "tab_main",
    "name": "Erreurs",
    "scope": null,
    "uncaught": false,
    "x": 140,
    "y": 340,
    "wires": [["debug_err"]]
  },
  {
