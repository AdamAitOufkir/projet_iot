    {
      "id": 100,
      "type": "text",
      "title": "",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 2
      },
      "options": {
        "mode": "markdown",
        "content": "**Projet 11 · Maintenance prédictive** : capteurs AI4I rejoués en MQTT → Node-RED (sous-flux Prétraitement_Machine) → modèle RandomForest → InfluxDB. Seuil d'alarme : **0.7** (attribut partagé ThingsBoard)."
      }
    },
    {
      "id": 1,
      "type": "gauge",
      "title": "Probabilité de panne : dernière valeur",
      "datasource": {
        "type": "influxdb",
        "uid": "influxdb-p11"
      },
      "gridPos": {
        "x": 0,
        "y": 2,
        "w": 12,
        "h": 7
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "influxdb",
            "uid": "influxdb-p11"
          },
          "query": "from(bucket: \"maintenance\")\n  |> range(start: v.timeRangeStart, stop: v.timeRangeStop)\n  |> filter(fn: (r) => r._measurement == \"machine\")\n  |> filter(fn: (r) => contains(value: r.machine_id, set: ${machine_id:json}))\n  |> filter(fn: (r) => r._field == \"panne_probable\")\n  |> last()\n"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 1,
          "decimals": 2,
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 0.5
              },
              {
                "color": "red",
                "value": 0.7
              }
            ]
          },
          "displayName": "${__field.labels.machine_id}"
        },
        "overrides": []
      },
      "options": {
        "showThresholdMarkers": true,
        "showThresholdLabels": false,
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      }
    },
