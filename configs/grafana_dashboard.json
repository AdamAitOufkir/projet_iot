        "type": "query",
        "datasource": {
          "type": "influxdb",
          "uid": "influxdb-p11"
        },
        "query": "import \"influxdata/influxdb/schema\"\nschema.tagValues(bucket: \"maintenance\", tag: \"machine_id\")",
        "definition": "machine_id tag values",
        "multi": true,
        "includeAll": true,
        "refresh": 2,
        "sort": 1,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
